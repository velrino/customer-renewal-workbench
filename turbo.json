{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["APP_ENV", "PORT", "GOOGLE_CLOUD_PROJECT", "GOOGLE_APPLICATION_CREDENTIALS", "FIRESTORE_DATABASE", "FIRESTORE_EMULATOR_HOST", "NEXT_PUBLIC_API_ORIGIN", "NEXT_PUBLIC_FIRESTORE_PROJECT_ID", "NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST", "SENTRY_DSN"]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": ["NEXT_PUBLIC_POSTHOG_ENABLED", "NEXT_PUBLIC_POSTHOG_HOST", "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN", "NEXT_PUBLIC_SENTRY_DSN", "NEXT_PUBLIC_API_ORIGIN", "NEXT_PUBLIC_FIRESTORE_PROJECT_ID", "NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST", "VERCEL_GIT_COMMIT_SHA", "VERCEL_ENV"],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"],
      "outputs": [
        "out/**"
      ]
    },
    "test": {},
    "typecheck": {}
  }
}
