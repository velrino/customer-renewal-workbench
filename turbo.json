{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": ["NEXT_PUBLIC_POSTHOG_ENABLED", "NEXT_PUBLIC_POSTHOG_HOST", "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN", "NEXT_PUBLIC_SENTRY_DSN", "VERCEL_GIT_COMMIT_SHA", "VERCEL_ENV"],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"],
      "outputs": [
        "out/**"
      ]
    },
    "test": {},
    "typecheck": {}
  }
}
