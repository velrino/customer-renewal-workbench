    {
      "id": "cfbdb7c7bc704eb9b5a57dc6974abedc",
      "type": "text",
      "x": 345,
      "y": 5931.5,
      "width": 775,
      "height": 71.25,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 8,
      "versionNonce": 1981530841,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Go verifies the Firebase ID token and derives the demo UID.\nFirestore rules allow reads of that UID’s account documents\nand deny all browser writes. Go authorizes every mutation.",
      "originalText": "Go verifies the Firebase ID token and derives the demo UID.\nFirestore rules allow reads of that UID’s account documents\nand deny all browser writes. Go authorizes every mutation.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "41b424655b3649cfba7990522be1b16c",
      "type": "text",
      "x": 1150,
      "y": 5931.5,
      "width": 775,
      "height": 71.25,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 7,
      "versionNonce": 1043063273,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Two tabs share live changes. An incognito session gets fresh seed\ndata.\nAnother UID cannot read or edit the first session.",
      "originalText": "Two tabs share live changes. An incognito session gets fresh seed\ndata.\nAnother UID cannot read or edit the first session.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
