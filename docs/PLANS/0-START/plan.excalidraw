      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Ember is seven days from renewal with budget pending. Cove has\na critical issue. The manager chooses which two plans to fund.",
      "originalText": "Ember is seven days from renewal with budget pending. Cove has\na critical issue. The manager chooses which two plans to fund.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
