    },
    {
      "id": "f8c061de91a24080b4fc",
      "type": "text",
      "x": 59,
      "y": 4162,
      "width": 1850,
      "height": 95.0,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "bf374409b9e09b44e1b0de4ba0ba13f8"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 8,
      "versionNonce": 506609568,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "1 · Pure rule functions with boundary tests.   2 · Workbench screen on in-memory seed data.   3 · Write API with server-side validation.\n4 · Listener and Firestore rules.   5 · Request limits and demo expiry.\nAPI plus realtime is more than the 3–5 hour guide: stop after any step and state what is missing in the README.\nNo analytics, error monitoring or paid model on this board; the rule-based queue needs none of them.",
      "originalText": "1 · Pure rule functions with boundary tests.   2 · Workbench screen on in-memory seed data.   3 · Write API with server-side validation.\n4 · Listener and Firestore rules.   5 · Request limits and demo expiry.\nAPI plus realtime is more than the 3–5 hour guide: stop after any step and state what is missing in the README.\nNo analytics, error monitoring or paid model on this board; the rule-based queue needs none of them.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
