      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Retained data and cost",
      "originalText": "Retained data and cost",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "f4addeeff4164c56b15bb5fb7099ab78",
      "type": "text",
      "x": 345,
      "y": 6431.5,
      "width": 775,
      "height": 95.0,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 8,
      "versionNonce": 1708574312,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Expire inactive demos and measure stored bytes across sessions.\nBlaze has no spending cap: set a budget alert\nand keep max-instances = 1. Reprice if the assumptions in the cost\ntable change.",
      "originalText": "Expire inactive demos and measure stored bytes across sessions.\nBlaze has no spending cap: set a budget alert\nand keep max-instances = 1. Reprice if the assumptions in the cost\ntable change.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "1cea8f2d0dc140c6a6a6893e0380606e",
      "type": "text",
      "x": 1150,
      "y": 6431.5,
      "width": 775,
      "height": 71.25,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 8,
      "versionNonce": 792257429,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Check total document and index storage against 1 GiB and\noutbound traffic against 10 GiB per month. Monitor daily\noperation counts and verify that budget alerts are enabled.",
      "originalText": "Check total document and index storage against 1 GiB and\noutbound traffic against 10 GiB per month. Monitor daily\noperation counts and verify that budget alerts are enabled.",
      "fontSize": 19,
