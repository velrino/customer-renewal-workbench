      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Scope and assumptions",
      "originalText": "Scope and assumptions",
      "fontSize": 30,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
