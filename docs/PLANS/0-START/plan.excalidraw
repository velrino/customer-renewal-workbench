      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Thresholds can miss gradual declines. The manager still\ndecides which two accounts get time.",
      "originalText": "Thresholds can miss gradual declines. The manager still\ndecides which two accounts get time.",
