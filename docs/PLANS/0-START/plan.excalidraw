      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b594e06020cd40f1b6c6a13e2cb3ce0a"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 8,
      "versionNonce": 1921783746,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Give each team a planning period and its own capacity\nwhen managers run separate portfolios.",
      "originalText": "Give each team a planning period and its own capacity\nwhen managers run separate portfolios.",
