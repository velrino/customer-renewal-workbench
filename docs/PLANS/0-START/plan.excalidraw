    {
      "id": "f8c061de91a24080b4fc",
      "type": "text",
      "x": 2054,
      "y": 3504.5,
      "width": 1942,
      "height": 95.0,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "bf374409b9e09b44e1b0de4ba0ba13f8"
      ],
