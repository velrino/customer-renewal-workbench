      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Input, errors and logs",
      "originalText": "Input, errors and logs",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "475825fca24a4759a4f1bab509271198",
      "type": "text",
      "x": 345,
      "y": 6852.75,
      "width": 775,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 9,
      "versionNonce": 2018073808,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "The API validates the command, account revision, time zone\nand follow-up date. It caps command bodies at 8 KiB.",
      "originalText": "The API validates the command, account revision, time zone\nand follow-up date. It caps command bodies at 8 KiB.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "bc4ff9ad65534e5f93efa0082bb902e8",
      "type": "text",
      "x": 1150,
      "y": 6852.75,
      "width": 775,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 9,
      "versionNonce": 192208556,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "A stale revision returns a conflict. An invalid command leaves\nthe board unchanged. API errors carry a reason code.",
      "originalText": "A stale revision returns a conflict. An invalid command leaves\nthe board unchanged. API errors carry a reason code.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
