    },
    {
      "id": "ce51ea89a2c146eaa9e785f7e969dc25",
      "type": "text",
      "x": 345,
      "y": 6056.5,
      "width": 775,
      "height": 71.25,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 7,
      "versionNonce": 584290084,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "A Firestore transaction reads the weekly capacity document,\nthen saves the account plan and its slot together. An existing\naccount keeps its slot. A third distinct account gets 409.",
      "originalText": "A Firestore transaction reads the weekly capacity document,\nthen saves the account plan and its slot together. An existing\naccount keeps its slot. A third distinct account gets 409.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "e33704c0dcde4fec9a7f53bf0b2ae699",
      "type": "text",
      "x": 1150,
      "y": 6056.5,
      "width": 775,
      "height": 71.25,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 7,
      "versionNonce": 328379536,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Two tabs claim the last slot. One succeeds; the other gets 409 and\nrefreshes the list.\nRetrying the winning save still uses just one slot.",
      "originalText": "Two tabs claim the last slot. One succeeds; the other gets 409 and\nrefreshes the list.\nRetrying the winning save still uses just one slot.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
