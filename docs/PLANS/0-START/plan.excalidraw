      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Scope and assumptions",
      "originalText": "Scope and assumptions",
      "fontSize": 30,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "29e8f9a17c0545a39392",
      "type": "text",
      "x": 59,
      "y": 3094,
      "width": 1850,
      "height": 95,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "c8d14388c03f5e86e76096998fd51f9a"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 7,
      "versionNonce": 53504449,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Buyer: head of customer success. Replace three spreadsheets with a single decision and follow-up workflow.\nMissing data prompts investigation; a hypothesis stays labeled until verified. An information request uses no weekly slot.\nThe manager allocates both slots and records a reason; the app only orders the queue. ACV breaks ties and never triggers a rule.\nSeed synthetic accounts per demo session. The React listener is the only read path; Go handles session start and every write. Owner follow-through is simulated.",
      "originalText": "Buyer: head of customer success. Replace three spreadsheets with a single decision and follow-up workflow.\nMissing data prompts investigation; a hypothesis stays labeled until verified. An information request uses no weekly slot.\nThe manager allocates both slots and records a reason; the app only orders the queue. ACV breaks ties and never triggers a rule.\nSeed synthetic accounts per demo session. The React listener is the only read path; Go handles session start and every write. Owner follow-through is simulated.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
