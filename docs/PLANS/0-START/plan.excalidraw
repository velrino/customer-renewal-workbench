      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Go HTTP service on Cloud Run (us-central1), max-instances = 1.\nPOST session; PUT plan; PATCH signals. No read endpoint.",
      "originalText": "Go HTTP service on Cloud Run (us-central1), max-instances = 1.\nPOST session; PUT plan; PATCH signals. No read endpoint.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "7d362310ec8d4faaa13d",
      "type": "text",
      "x": 1180,
      "y": 3804,
      "width": 765,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "6e190b179736dd022b962925788a0b3d"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 7,
      "versionNonce": 862255297,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Verify the ID token on every call; take the UID only from it.\nValidate input; commit slots and plan atomically; exact-origin CORS.",
