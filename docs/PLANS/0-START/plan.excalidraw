      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "eb5c49f9437740e48c25c92a25f1d98a",
      "type": "text",
      "x": 1259.6883116883116,
      "y": 4085.5,
      "width": 716.3116883116884,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b594e06020cd40f1b6c6a13e2cb3ce0a"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
