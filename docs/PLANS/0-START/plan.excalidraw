      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Input, errors and logs",
      "originalText": "Input, errors and logs",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
