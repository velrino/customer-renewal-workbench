      "type": "text",
      "x": 59,
      "y": 3342,
      "width": 1850,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "94eae7f9521e43d9aec6b59d5b26adf7"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 8,
      "versionNonce": 771471722,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Measure the share of accounts due this sample month with a dated, evidence-linked plan saved before renewal.\nThis measures planning coverage; it cannot establish that an intervention prevented churn.",
      "originalText": "Measure the share of accounts due this sample month with a dated, evidence-linked plan saved before renewal.\nThis measures planning coverage; it cannot establish that an intervention prevented churn.",
      "fontSize": 19,
      "fontFamily": 6,
