    },
    {
      "id": "2da6c3de81f040a0a509718c21f9b71c",
      "type": "text",
      "x": 435,
      "y": 7692.5,
      "width": 790,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b594e06020cd40f1b6c6a13e2cb3ce0a"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 8,
      "versionNonce": 1164766218,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Anyone can try or reset the synthetic board. API request limits\napply per peer and instance. Reset also has a shared cooldown.",
      "originalText": "Anyone can try or reset the synthetic board. API request limits\napply per peer and instance. Reset also has a shared cooldown.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "3de0179b53a94a209585efe1579de8b9",
      "type": "text",
      "x": 1255,
      "y": 7692.5,
      "width": 690,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
