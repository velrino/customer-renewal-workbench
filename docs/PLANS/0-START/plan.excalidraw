    {
      "id": "926440741b4748d7825e15d49778111c",
      "type": "text",
      "x": 1255,
      "y": 6884.25,
      "width": 690,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
