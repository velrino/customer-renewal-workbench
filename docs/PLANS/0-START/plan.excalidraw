    {
      "id": "cfbdb7c7bc704eb9b5a57dc6974abedc",
      "type": "text",
      "x": 345,
      "y": 6501.5,
      "width": 775,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
