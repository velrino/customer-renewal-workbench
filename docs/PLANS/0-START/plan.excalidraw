      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Managers can inspect the signal behind each flag. Drift’s failed\nreport stays visible as missing evidence.",
      "originalText": "Managers can inspect the signal behind each flag. Drift’s failed\nreport stays visible as missing evidence.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
