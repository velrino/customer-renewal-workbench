      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Anyone can try or reset the synthetic board. API request limits\napply per peer and instance. Reset also has a shared cooldown.",
      "originalText": "Anyone can try or reset the synthetic board. API request limits\napply per peer and instance. Reset also has a shared cooldown.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
