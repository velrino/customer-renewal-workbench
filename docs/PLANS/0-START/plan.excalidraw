      "link": null,
      "locked": false,
      "text": "Prioritize Ember and Cove",
      "originalText": "Prioritize Ember and Cove",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
