      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Input, errors and logs",
      "originalText": "Input, errors and logs",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "475825fca24a4759a4f1bab509271198",
      "type": "text",
      "x": 345,
      "y": 6282.75,
      "width": 775,
      "height": 118.75,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 8,
      "versionNonce": 2018073808,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Validate on the server: action from a fixed list, owner and notes\nlength-capped, follow-up date valid and on or before renewal, body\nsize capped.\nErrors return a code and a field name, never a stack trace. Logs\nomit tokens and free-text notes.",
      "originalText": "Validate on the server: action from a fixed list, owner and notes\nlength-capped, follow-up date valid and on or before renewal, body\nsize capped.\nErrors return a code and a field name, never a stack trace. Logs\nomit tokens and free-text notes.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "bc4ff9ad65534e5f93efa0082bb902e8",
      "type": "text",
      "x": 1150,
      "y": 6282.75,
      "width": 775,
      "height": 71.25,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 8,
      "versionNonce": 192208556,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Omitting the owner returns 422 naming the field and stores nothing.\nAn unknown action or an oversized body is rejected.\nA forced server error shows a generic message in the UI.",
      "originalText": "Omitting the owner returns 422 naming the field and stores nothing.\nAn unknown action or an oversized body is rejected.\nA forced server error shows a generic message in the UI.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
