    },
    {
      "id": "fad069d9115f451d80b0f406554f0936",
      "type": "text",
      "x": 435,
      "y": 7051.0,
      "width": 790,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
