      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "How to read the estimate",
      "originalText": "How to read the estimate",
      "fontSize": 30,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "a666ee9ba8794346a1d9f965a14074f8",
      "type": "text",
      "x": 59,
      "y": 4916,
      "width": 1850,
      "height": 142.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b4a664288d448318d5359ce8058d372a"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 7,
      "versionNonce": 2015060750,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Each monthly reviewer makes 100 API calls, reads 300 documents, writes 150, deletes 8 and receives 2 MiB from Firestore.\nReads include snapshots, updates, reconnects and transactions. Writes include seeds, plan edits and weekly capacity changes.\nAssume traffic is evenly spread across 30 days and cleanup keeps average storage within 1 GiB, including indexes.\nAt 100,000 reviewers: 30M reads, 15M writes, 800k ordinary deletes and 195.31 GiB outbound. Americas transfer costs $0.12/GiB above 10 GiB.\nBursts, retries and longer retention can raise costs. Managed TTL, backups and point-in-time recovery are excluded.\n¹ Choose one eligible host. Totals assume available free quotas and one Pro seat.",
      "originalText": "Each monthly reviewer makes 100 API calls, reads 300 documents, writes 150, deletes 8 and receives 2 MiB from Firestore.\nReads include snapshots, updates, reconnects and transactions. Writes include seeds, plan edits and weekly capacity changes.\nAssume traffic is evenly spread across 30 days and cleanup keeps average storage within 1 GiB, including indexes.\nAt 100,000 reviewers: 30M reads, 15M writes, 800k ordinary deletes and 195.31 GiB outbound. Americas transfer costs $0.12/GiB above 10 GiB.\nBursts, retries and longer retention can raise costs. Managed TTL, backups and point-in-time recovery are excluded.\n¹ Choose one eligible host. Totals assume available free quotas and one Pro seat.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
