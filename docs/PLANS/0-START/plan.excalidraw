    },
    {
      "id": "29e8f9a17c0545a39392",
      "type": "text",
      "x": 59,
      "y": 3664,
      "width": 1850,
      "height": 95.0,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "c8d14388c03f5e86e76096998fd51f9a"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 8,
      "versionNonce": 53504449,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "The head of customer success buys the workbench. A manager chooses where two interventions can make a difference this week.\nSix fictional accounts expose conflicting signals, unresolved risks and missing evidence. Information requests use no slot.\nThe default queue sorts by attention group and then nearest renewal. The manager chooses the accounts and records the evidence.\nLocal work belongs to one browser profile. In Shared API mode everyone sees the same board. Each plan keeps its original evidence.",
      "originalText": "The head of customer success buys the workbench. A manager chooses where two interventions can make a difference this week.\nSix fictional accounts expose conflicting signals, unresolved risks and missing evidence. Information requests use no slot.\nThe default queue sorts by attention group and then nearest renewal. The manager chooses the accounts and records the evidence.\nLocal work belongs to one browser profile. In Shared API mode everyone sees the same board. Each plan keeps its original evidence.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "20f1825928ec466fa3d19c91998c966b",
      "type": "rectangle",
      "x": 35,
      "y": 3850,
      "width": 1910,
      "height": 144,
      "angle": 0,
