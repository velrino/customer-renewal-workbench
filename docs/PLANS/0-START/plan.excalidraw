      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "The browser can read the fictional shared document. The API\nvalidates every command. Local work stays in IndexedDB.",
      "originalText": "The browser can read the fictional shared document. The API\nvalidates every command. Local work stays in IndexedDB.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "41b424655b3649cfba7990522be1b16c",
      "type": "text",
      "x": 1150,
      "y": 6501.5,
      "width": 775,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 8,
      "versionNonce": 1043063273,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Two browser profiles in Shared API see the same committed plan.\nSwitch to Local to see only the current profile’s work.",
      "originalText": "Two browser profiles in Shared API see the same committed plan.\nSwitch to Local to see only the current profile’s work.",
      "fontSize": 19,
      "fontFamily": 6,
