      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Request limits",
      "originalText": "Request limits",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "0a538a45389544539b4956591d4c174c",
      "type": "text",
      "x": 345,
      "y": 6157.75,
      "width": 775,
      "height": 95.0,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 8,
      "versionNonce": 1264335440,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Apply separate limits to session creation and plan writes. With\nmax-instances = 1 an in-memory limiter is enough;\nmove the counters to a shared store before raising the instance\ncap.",
      "originalText": "Apply separate limits to session creation and plan writes. With\nmax-instances = 1 an in-memory limiter is enough;\nmove the counters to a shared store before raising the instance\ncap.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "9383c7f8103e4cffaa923e6ab47c98e3",
      "type": "text",
      "x": 1150,
      "y": 6157.75,
      "width": 775,
      "height": 71.25,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 7,
      "versionNonce": 1417712418,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "When throttled, return 429 and Retry-After. Keep the form draft and\nallow normal viewing.\nA write limit in Go does not meter Firestore listener reads.",
      "originalText": "When throttled, return 429 and Retry-After. Keep the form draft and\nallow normal viewing.\nA write limit in Go does not meter Firestore listener reads.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
