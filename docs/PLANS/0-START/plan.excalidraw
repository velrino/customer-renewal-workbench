      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "f4addeeff4164c56b15bb5fb7099ab78",
      "type": "text",
      "x": 2351.3560209424086,
      "y": 4148.5,
      "width": 810.7172774869109,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 10,
      "versionNonce": 1708574312,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "A confirmed reset takes no request body. One transaction\nclears edits and advances revisions for all six accounts.",
      "originalText": "A confirmed reset takes no request body. One transaction\nclears edits and advances revisions for all six accounts.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "1cea8f2d0dc140c6a6a6893e0380606e",
      "type": "text",
      "x": 3190.073298429319,
      "y": 4148.5,
      "width": 815.9267015706807,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 10,
      "versionNonce": 792257429,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "An editor opened before a reset cannot overwrite the reset.\nA second reset within 60 seconds returns a retry delay.",
      "originalText": "An editor opened before a reset cannot overwrite the reset.\nA second reset within 60 seconds returns a retry delay.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
