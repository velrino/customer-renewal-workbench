      "roundness": null,
      "seed": 1032566316,
      "version": 9,
      "versionNonce": 2015060750,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Scenario per reviewer per month: 100 API calls, 300 document reads, 150 writes, eight deletes and 2 MiB of Firestore outbound traffic.\nReads include snapshots, reconnects and transactions. Deletes budget for cleanup in a larger portfolio. The demo reset rewrites one document.\nSpread traffic over 30 days and assume storage including indexes stays within 1 GiB.\nAt 100,000 reviewers: 30M reads, 15M writes, 800k deletes and 195.31 GiB outbound. Model Americas transfer at $0.12/GiB above 10 GiB.\nBursts, retries and retention can raise costs. Managed TTL, backups and point-in-time recovery are excluded.\n¹ Choose one eligible host. Totals assume available free quotas and one Pro seat. Actual demo charges are unmeasured.",
      "originalText": "Scenario per reviewer per month: 100 API calls, 300 document reads, 150 writes, eight deletes and 2 MiB of Firestore outbound traffic.\nReads include snapshots, reconnects and transactions. Deletes budget for cleanup in a larger portfolio. The demo reset rewrites one document.\nSpread traffic over 30 days and assume storage including indexes stays within 1 GiB.\nAt 100,000 reviewers: 30M reads, 15M writes, 800k deletes and 195.31 GiB outbound. Model Americas transfer at $0.12/GiB above 10 GiB.\nBursts, retries and retention can raise costs. Managed TTL, backups and point-in-time recovery are excluded.\n¹ Choose one eligible host. Totals assume available free quotas and one Pro seat. Actual demo charges are unmeasured.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
