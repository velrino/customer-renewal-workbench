      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 7,
      "versionNonce": 1164766218,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "A transaction saves the plan and reserves its slot together, even\nwhen two tabs claim the last opening.",
      "originalText": "A transaction saves the plan and reserves its slot together, even\nwhen two tabs claim the last opening.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "eb5c49f9437740e48c25c92a25f1d98a",
      "type": "text",
      "x": 1255,
      "y": 7051.0,
      "width": 690,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b594e06020cd40f1b6c6a13e2cb3ce0a"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 6,
      "versionNonce": 1921783746,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Concurrent edits for the same demo week can trigger\nretries. Limit contention to that session and week.",
      "originalText": "Concurrent edits for the same demo week can trigger\nretries. Limit contention to that session and week.",
