      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "A single instance keeps the demo small and makes an in-memory\nrequest limit practical.",
      "originalText": "A single instance keeps the demo small and makes an in-memory\nrequest limit practical.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
