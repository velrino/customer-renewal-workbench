      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Write through Go and listen\nto Firestore",
      "originalText": "Write through Go and listen\nto Firestore",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "f8cada827d6b4c3c8d0cb945d1c6ad78",
      "type": "text",
      "x": 435,
      "y": 6955.75,
      "width": 790,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b594e06020cd40f1b6c6a13e2cb3ce0a"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 7,
      "versionNonce": 1164766218,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "The API validates every change. A Firestore listener shows an\nowner’s update in another tab without a refresh.",
      "originalText": "The API validates every change. A Firestore listener shows an\nowner’s update in another tab without a refresh.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "0de175618419474a9f341f5814776459",
      "type": "text",
      "x": 1255,
      "y": 6955.75,
      "width": 690,
      "height": 71.25,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b594e06020cd40f1b6c6a13e2cb3ce0a"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 6,
      "versionNonce": 1921783746,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Two access paths need separate checks. Test API\nauthorization and Firestore read rules. Reconnects can\nadd billed reads.",
      "originalText": "Two access paths need separate checks. Test API\nauthorization and Firestore read rules. Reconnects can\nadd billed reads.",
      "fontSize": 19,
