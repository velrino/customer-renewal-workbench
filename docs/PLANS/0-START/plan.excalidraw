      "text": "Reserve slots in one weekly\ndocument",
      "originalText": "Reserve slots in one weekly\ndocument",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
