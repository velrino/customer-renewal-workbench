    {
      "id": "633ea4e351ac4fffa2a1b93a896d66fb",
      "type": "text",
      "x": 435,
      "y": 6741.25,
      "width": 790,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b594e06020cd40f1b6c6a13e2cb3ce0a"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 7,
      "versionNonce": 1164766218,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Budget approval is pending seven days before Ember renews. Cove\nhas a critical issue its owner can escalate now.",
      "originalText": "Budget approval is pending seven days before Ember renews. Cove\nhas a critical issue its owner can escalate now.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "9acf584d26a644c6b471b93fa9e01dfb",
      "type": "text",
      "x": 1255,
      "y": 6741.25,
      "width": 690,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b594e06020cd40f1b6c6a13e2cb3ce0a"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 6,
      "versionNonce": 1921783746,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Beacon waits despite a sharp usage drop. Revisit the\nchoice if its sponsor responds or Cove’s issue closes.",
      "originalText": "Beacon waits despite a sharp usage drop. Revisit the\nchoice if its sponsor responds or Cove’s issue closes.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
