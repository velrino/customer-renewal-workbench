    {
      "id": "25ccf94d47684c4f8c28a6c28103c9a8",
      "type": "text",
      "x": 50,
      "y": 6157.75,
      "width": 270,
      "height": 23.75,
      "angle": 0,
      "strokeColor": "#26232a",
