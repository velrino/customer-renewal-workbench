      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "IndexedDB stores the local board during an outage. Returning to\nShared API reconnects the listener. Local edits stay local.",
      "originalText": "IndexedDB stores the local board during an outage. Returning to\nShared API reconnects the listener. Local edits stay local.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
