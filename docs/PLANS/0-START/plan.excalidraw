    {
      "id": "b9960963b17d43e79d90",
      "type": "text",
      "x": 35,
      "y": 3046,
      "width": 1910,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
