      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Last weekly slot",
      "originalText": "Last weekly slot",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "ce51ea89a2c146eaa9e785f7e969dc25",
      "type": "text",
      "x": 2351.3560209424086,
      "y": 3879.5,
      "width": 810.7172774869109,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 9,
      "versionNonce": 584290084,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "The transaction reads the shared board, checks the account\nrevision and remaining capacity, then writes the updated board.",
      "originalText": "The transaction reads the shared board, checks the account\nrevision and remaining capacity, then writes the updated board.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "e33704c0dcde4fec9a7f53bf0b2ae699",
      "type": "text",
      "x": 3190.073298429319,
      "y": 3879.5,
      "width": 815.9267015706807,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "b481a86363d408c1be8ad5a5266dff49"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 9,
      "versionNonce": 328379536,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "When two commands compete for the final slot, one commits.\nThe other receives a conflict. Editing a plan keeps its slot.",
      "originalText": "When two commands compete for the final slot, one commits.\nThe other receives a conflict. Editing a plan keeps its slot.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
