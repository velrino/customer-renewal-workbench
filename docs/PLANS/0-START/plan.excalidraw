      "type": "text",
      "x": 24,
      "y": 3504.5,
      "width": 1942,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "groupIds": [
        "94eae7f9521e43d9aec6b59d5b26adf7"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032566316,
      "version": 10,
      "versionNonce": 771471722,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "Measure the share of accounts renewing within 30 days with an evidence-linked plan, an owner and a follow-up by renewal.\nThe demo measures planning coverage. Evaluating renewal impact would require outcome data and a comparison group.",
      "originalText": "Measure the share of accounts renewing within 30 days with an evidence-linked plan, an owner and a follow-up by renewal.\nThe demo measures planning coverage. Evaluating renewal impact would require outcome data and a comparison group.",
