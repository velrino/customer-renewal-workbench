      "versionNonce": 506609568,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795117555292,
      "link": null,
      "locked": false,
      "text": "The static dashboard and Go service deploy separately. CI checks the frontend build and backend race tests and build.\nThe emulator supports shared-board checks, including competing writes, stale revisions and the reset cooldown.\nPostHog records product events. Sentry reports errors from the browser and API.\nThe repository README links to local and shared walkthroughs, setup guides and the live API reference.",
      "originalText": "The static dashboard and Go service deploy separately. CI checks the frontend build and backend race tests and build.\nThe emulator supports shared-board checks, including competing writes, stale revisions and the reset cooldown.\nPostHog records product events. Sentry reports errors from the browser and API.\nThe repository README links to local and shared walkthroughs, setup guides and the live API reference.",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
      "baseFontSize": null
    },
