    {
      "id": "633ea4e351ac4fffa2a1b93a896d66fb",
      "type": "text",
      "x": 412.0,
      "y": 3797.5,
      "width": 819.6883116883116,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
