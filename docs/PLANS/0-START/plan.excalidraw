      "x": 50,
      "y": 6852.75,
      "width": 270,
      "height": 23.75,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
