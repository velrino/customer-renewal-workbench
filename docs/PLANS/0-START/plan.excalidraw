    {
      "id": "a32ab5794fda4ba9ad5603c9dff2ebbd",
      "type": "text",
      "x": 35,
      "y": 4868,
      "width": 1910,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
