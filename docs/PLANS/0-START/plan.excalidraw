      "link": null,
      "locked": false,
      "text": "Build order · every step leaves something that can ship",
      "originalText": "Build order · every step leaves something that can ship",
      "fontSize": 30,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1795117555283,
      "labelPosition": null,
