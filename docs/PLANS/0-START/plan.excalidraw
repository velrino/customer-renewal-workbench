    {
      "id": "9ab69f1cc3494cafbb9b4750a7c078ec",
      "type": "text",
      "x": 50,
      "y": 6282.75,
      "width": 270,
      "height": 23.75,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
