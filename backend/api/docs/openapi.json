{
  "openapi": "3.0.3",
  "info": {
    "title": "Customer Renewal Workbench API",
    "version": "1.1.0"
  },
  "tags": [
    {
      "name": "Health",
      "description": "Service availability and Firestore dependency checks."
    },
    {
      "name": "Renewals",
      "description": "Account updates and reset operations for the shared renewal workbench."
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getHealth",
        "summary": "Check service health",
        "description": "Checks that the Firestore Admin API can return metadata for the configured database within three seconds. Document reads and writes are outside this check. Each instance caches healthy reads for 60 seconds and failures for five seconds. Response times are in milliseconds.",
        "responses": {
          "200": {
            "description": "Firestore database metadata is available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Firestore is unavailable or unconfigured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/workbench/accounts/{account}/commands": {
      "post": {
        "tags": [
          "Renewals"
        ],
        "operationId": "applyAccountCommand",
        "summary": "Update a shared account",
        "description": "Send the account revision from the latest snapshot (zero for an untouched account). Plan dates use the supplied IANA time zone. A transaction enforces the two-slot limit. Only Cove has a critical issue to resolve. Completing a plan frees its slot.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountCommand"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Committed. The Firestore document listener receives the resulting state."
          },
          "400": {
            "description": "Invalid request or version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError"
                }
              }
            }
          },
          "409": {
            "description": "Account changed or both slots are in use",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError"
                }
              }
            }
          },
          "415": {
            "description": "Expected application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError"
                }
              }
            }
          },
          "503": {
            "description": "Firestore transaction unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError"
                }
              }
            }
          },
          "404": {
            "description": "Unknown sample account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid workflow command or field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/WriteRateLimited"
          }
        },
        "parameters": [
          {
            "name": "account",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ember",
                "beacon",
                "cove",
                "drift",
                "atlas",
                "field"
              ]
            }
          }
        ]
      }
    },
    "/workbench/reset": {
      "post": {
        "tags": [
          "Renewals"
        ],
        "operationId": "resetSharedWorkbench",
        "summary": "Reset the shared demo for everyone",
        "description": "Restores the six sample accounts for everyone. The API clears saved plans, questions and owner actions in one Firestore transaction, including edits committed before the reset. Earlier drafts cannot overwrite the restored state. Send an empty POST.",
        "responses": {
          "204": {
            "description": "Committed. The Firestore document listener receives the resulting state."
          },
          "400": {
            "description": "The request body must be empty",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError"
                }
              }
            }
          },
          "503": {
            "description": "Firestore transaction unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/WriteRateLimited"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "name",
          "status",
          "app_env",
          "author",
          "runtime",
          "checks",
          "cache",
          "result_time"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string"
          },
          "app_env": {
            "type": "string"
          },
          "author": {
            "$ref": "#/components/schemas/Author"
          },
          "runtime": {
            "$ref": "#/components/schemas/Runtime"
          },
          "checks": {
            "type": "object",
            "required": [
              "firestore"
            ],
            "properties": {
              "firestore": {
                "$ref": "#/components/schemas/Dependency"
              }
            }
          },
          "cache": {
            "$ref": "#/components/schemas/Cache"
          },
          "result_time": {
            "type": "object",
            "required": [
              "total",
              "average"
            ],
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "average": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "Author": {
        "type": "object",
        "required": [
          "name",
          "github",
          "linkedin",
          "instagram",
          "website"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "github": {
            "type": "string"
          },
          "linkedin": {
            "type": "string"
          },
          "instagram": {
            "type": "string"
          },
          "website": {
            "type": "string"
          }
        }
      },
      "Runtime": {
        "type": "object",
        "required": [
          "last_deploy",
          "uptime"
        ],
        "properties": {
          "last_deploy": {
            "type": "string",
            "format": "date-time"
          },
          "uptime": {
            "type": "object",
            "required": [
              "start",
              "end",
              "years",
              "months",
              "days",
              "hours",
              "minutes",
              "seconds"
            ],
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time"
              },
              "end": {
                "type": "string",
                "format": "date-time"
              },
              "years": {
                "type": "integer",
                "minimum": 0
              },
              "months": {
                "type": "integer",
                "minimum": 0
              },
              "days": {
                "type": "integer",
                "minimum": 0
              },
              "hours": {
                "type": "integer",
                "minimum": 0
              },
              "minutes": {
                "type": "integer",
                "minimum": 0
              },
              "seconds": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "Dependency": {
        "type": "object",
        "required": [
          "status",
          "response_time"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "response_time": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string",
            "enum": [
              "UNAVAILABLE",
              "TIMEOUT_EXCEEDED",
              "CHECK_NOT_CONFIGURED"
            ]
          }
        }
      },
      "Cache": {
        "type": "object",
        "required": [
          "hit",
          "created_at",
          "expires_at",
          "seconds_remaining"
        ],
        "properties": {
          "hit": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "seconds_remaining": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Command": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "action",
              "owner",
              "followUp"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "plan"
                ]
              },
              "action": {
                "type": "string",
                "enum": [
                  "resolveIssue",
                  "budget",
                  "reconnect",
                  "adoption",
                  "checkIn"
                ]
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "followUp": {
                "type": "string",
                "format": "date"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "question"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "information"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "complete"
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "resolve"
                ]
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "AccountCommand": {
        "type": "object",
        "required": [
          "revision",
          "timeZone",
          "command"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "timeZone": {
            "type": "string",
            "example": "America/Sao_Paulo"
          },
          "command": {
            "$ref": "#/components/schemas/Command"
          }
        },
        "additionalProperties": false
      },
      "WriteError": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "invalidRequest",
              "unknownAccount",
              "changed",
              "full",
              "ownerRequired",
              "invalidDate",
              "invalidAction",
              "questionRequired",
              "invalidCommand",
              "storage",
              "rateLimited"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "WriteRateLimited": {
        "description": "The write limit was reached. Retry after the indicated number of seconds.",
        "headers": {
          "Retry-After": {
            "description": "Seconds until another attempt is allowed.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/WriteError"
            }
          }
        }
      }
    }
  }
}
